// BSLLS:LatinAndCyrillicSymbolInWord-off

#Использовать asserts

// Общие служебные функции библиотеки ibcmdrunner.
// Модуль устраняет дублирование кода между классами УправлениеИБ, УправлениеАС и КонфигурационныйФайлАС.
// Не предназначен для использования за пределами библиотеки, но экспортируется
// для возможности модульного тестирования.

#Область ПрограммныйИнтерфейс

// ИмяЛога
//      Возвращает имя лога библиотеки.
//
// Возвращаемое значение:
//   Строка - имя лога библиотеки
//
Функция ИмяЛога() Экспорт
	Возврат "oscript.lib.ibcmdrunner";
КонецФункции

// ОбернутьВКавычки
//      Оборачивает строку в двойные кавычки, если это не сделано ранее.
//
// Параметры:
//   Строка - Строка - исходная строка
//
// Возвращаемое значение:
//   Строка - обернутая в кавычки строка
//
Функция ОбернутьВКавычки(Знач Строка) Экспорт

	Если Сред(Строка, 1, 1) = """"
		И Сред(Строка, СтрДлина(Строка), 1) = """"
		И СтрДлина(Строка) > 1 Тогда
		Результат = Строка;
	Иначе
		Результат = """" + Строка + """";
	КонецЕсли;

	Возврат Результат;

КонецФункции

// СравнитьВерсии
//      Сравнивает две строки версий по числовым компонентам.
//
// Параметры:
//   ЭтаВерсия - Строка - первый сравниваемый номер версии
//   ДругаяВерсия - Строка - второй сравниваемый номер версии
//
// Возвращаемое значение:
//   Число - больше 0, если ЭтаВерсия > ДругаяВерсия;
//      0, если версии равны;
//      меньше 0, если ЭтаВерсия < ДругаяВерсия.
//
Функция СравнитьВерсии(Знач ЭтаВерсия, Знач ДругаяВерсия) Экспорт

	Ожидаем.Что(ЭтаВерсия).ИмеетТип("Строка");
	Ожидаем.Что(ДругаяВерсия).ИмеетТип("Строка");

	КомпонентыЭтойВерсии = МассивКомпонентВерсии(ЭтаВерсия);
	КомпонентыДругойВерсии = МассивКомпонентВерсии(ДругаяВерсия);

	// Недостающие компоненты считаются нулями: "8.3" = "8.3.0.0"
	Для Индекс = 0 По Макс(КомпонентыЭтойВерсии.Количество(), КомпонентыДругойВерсии.Количество()) - 1 Цикл

		ЭтаКомпонента = ?(Индекс < КомпонентыЭтойВерсии.Количество(), КомпонентыЭтойВерсии[Индекс], 0);
		ДругаяКомпонента = ?(Индекс < КомпонентыДругойВерсии.Количество(), КомпонентыДругойВерсии[Индекс], 0);

		Если ЭтаКомпонента <> ДругаяКомпонента Тогда
			Возврат ?(ЭтаКомпонента > ДругаяКомпонента, 1, -1);
		КонецЕсли;

	КонецЦикла;

	Возврат 0;

КонецФункции

// МассивКомпонентВерсии
//      Раскладывает строку с версией на числовые компоненты.
//      Пробелы игнорируются ("1  002" читается как 1002), любой нечисловой
//      символ считается разделителем компонент.
//
// Параметры:
//   Версия - Строка - строка с номером версии
//
// Возвращаемое значение:
//   Массив - массив чисел - компонент версии
//
Функция МассивКомпонентВерсии(Знач Версия) Экспорт

	РегулярноеВыражение = Новый РегулярноеВыражение("\s");
	СтрокаБезПробелов = РегулярноеВыражение.Заменить(Версия, "");

	РегулярноеВыражение = Новый РегулярноеВыражение("(\d+)");
	МассивСовпадений = РегулярноеВыражение.НайтиСовпадения(СтрокаБезПробелов);

	МассивКомпонент = Новый Массив;
	Для Каждого Совпадение Из МассивСовпадений Цикл
		МассивКомпонент.Добавить(Число(Совпадение.Значение));
	КонецЦикла;

	Возврат МассивКомпонент;

КонецФункции

// БулевоВСтрокуYesNo
//      Преобразует Булево в строку "yes" или "no" (формат параметров ibcmd).
//
// Параметры:
//   Значение - Булево - преобразуемое значение
//
// Возвращаемое значение:
//   Строка - "yes" или "no"
//
Функция БулевоВСтрокуYesNo(Знач Значение) Экспорт

	Ожидаем.Что(Значение).ИмеетТип("Булево");
	Возврат ?(Значение, "yes", "no");

КонецФункции

// СтрокаYesNoВБулево
//      Преобразует строку "yes" или "no" в Булево.
//      Для любого другого значения вызывает исключение.
//
// Параметры:
//   Значение - Строка - "yes" или "no"
//
// Возвращаемое значение:
//   Булево
//
Функция СтрокаYesNoВБулево(Знач Значение) Экспорт

	Ожидаем.Что(Значение).ИмеетТип("Строка");

	Если Значение = "yes" Тогда
		Результат = Истина;
	ИначеЕсли Значение = "no" Тогда
		Результат = Ложь;
	Иначе
		ВызватьИсключение СтрШаблон(
			"Значение для преобразования в тип Булево должно быть только 'yes' или 'no', получено: '%1'", Значение);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// ЯвляетсяИменем
//      Проверяет, что переданная строка удовлетворяет требованиям к именам 1С:
//      состоит из одного слова, начинается с буквы или "_" и не содержит
//      специальных символов, кроме "_".
//
// Параметры:
//   ПроверяемаяСтрока - Строка - проверяемая строка
//
// Возвращаемое значение:
//   Булево - Истина, если строка удовлетворяет требованиям к именам 1С
//
Функция ЯвляетсяИменем(Знач ПроверяемаяСтрока) Экспорт

	РегулярноеВыражение = Новый РегулярноеВыражение("^[a-zа-яёA-ZА-ЯЁ_][a-zа-яёA-ZА-ЯЁ0-9_]*$");
	Возврат РегулярноеВыражение.Совпадает(ПроверяемаяСтрока);

КонецФункции

// ШаблонПеременнойСреды
//      Возвращает подстановку переменной среды в синтаксисе командной оболочки
//      текущей ОС: %ИМЯ% для Windows, $ИМЯ для остальных ОС.
//
// Параметры:
//   ИмяПеременной - Строка - имя переменной среды
//   ЭтоWindows - Булево - Истина, если текущая ОС - Windows
//
// Возвращаемое значение:
//   Строка - подстановка переменной среды
//
Функция ШаблонПеременнойСреды(Знач ИмяПеременной, Знач ЭтоWindows) Экспорт

	Если ЭтоWindows Тогда
		Возврат СтрШаблон("%%%1%%", ИмяПеременной);
	Иначе
		Возврат СтрШаблон("$%1", ИмяПеременной);
	КонецЕсли;

КонецФункции

#КонецОбласти


#Использовать ".."
#Использовать asserts
#Использовать tempfiles

Перем ВременныйКаталог;
Перем АвтономныйСервер;

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ПолучитьВерсию() Экспорт

	// Дано
	УправлениеАС = Новый УправлениеАС;

	// Когда
	НомерВерсии = УправлениеАС.Версия();

	// Тогда
	РегулярноеВыражение = Новый РегулярноеВыражение("^(\d+)\.(\d+)\.(\d+)\.(\d+)\z");
	Утверждения.ПроверитьИстину(РегулярноеВыражение.Совпадает(НомерВерсии), 
		"Номер версии должен соответствовать шаблону:" + НомерВерсии);
		
КонецПроцедуры

&Тест
Процедура ТестДолжен_УстановитьНекорректнуюВерсию() Экспорт

	// Дано
	УправлениеАС = Новый УправлениеАС;
	
	// Когда
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("8.3.23.1111");
	
	// Тогда
	Ожидаем.Что(УправлениеАС)
		.Метод("УстановитьВерсиюПлатформы", ПараметрыМетода)
		.ВыбрасываетИсключение("Не найдена установленная версия платформы");
		
КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьКаталогЖурналаРегистрацииПоОтносительномуПути() Экспорт

	// Дано
	УправлениеАС = Новый УправлениеАС;
	ВременныйКаталог = ВременныеФайлы.СоздатьКаталог();
	КаталогЖурнала = ОбъединитьПути(ВременныйКаталог, "Журнал регистрации");
	ТекКаталог = ТекущийКаталог();
	УстановитьТекущийКаталог(ВременныйКаталог);

	// Когда
	Попытка
		УправлениеАС.УстановитьКаталогЖурналаРегистрации("Журнал регистрации");
	Исключение
		УстановитьТекущийКаталог(ТекКаталог);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьТекущийКаталог(ТекКаталог);

	// Тогда
	Утверждения.ПроверитьИстину(ФС.КаталогСуществует(КаталогЖурнала),
		"Каталог журнала должен быть создан относительно каталога вызывающего кода");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СохранитьСуществующийЖурналРегистрации() Экспорт

	// Дано
	УправлениеАС = Новый УправлениеАС;
	ВременныйКаталог = ВременныеФайлы.СоздатьКаталог();
	ПутьКФайлуЖурнала = ОбъединитьПути(ВременныйКаталог, "1Cv8.lgf");
	Запись = Новый ЗаписьТекста(ПутьКФайлуЖурнала, КодировкаТекста.UTF8NoBOM);
	Запись.Записать("существующий журнал");
	Запись.Закрыть();

	// Когда
	УправлениеАС.УстановитьКаталогЖурналаРегистрации(ВременныйКаталог);
	УправлениеАС.УстановитьКаталогЖурналаРегистрации(ВременныйКаталог);

	// Тогда
	Чтение = Новый ЧтениеТекста(ПутьКФайлуЖурнала, КодировкаТекста.UTF8);
	ТекстЖурнала = Чтение.Прочитать();
	Чтение.Закрыть();
	Утверждения.ПроверитьРавенство("существующий журнал", ТекстЖурнала,
		"Повторная настройка каталога не должна очищать существующий журнал");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОтклонитьПустойКаталогЖурналаРегистрации() Экспорт

	// Дано
	УправлениеАС = Новый УправлениеАС;
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("");

	// Когда / Тогда
	Ожидаем.Что(УправлениеАС)
		.Метод("УстановитьКаталогЖурналаРегистрации", ПараметрыМетода)
		.ВыбрасываетИсключение("Не указан каталог журнала регистрации");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьФайлЖурналаРегистрацииВУказанномКаталоге() Экспорт

	// Дано
	ВременныйКаталог = ВременныеФайлы.СоздатьКаталог();
	КаталогИБ = ОбъединитьПути(ВременныйКаталог, "ib");
	КаталогДанных = ОбъединитьПути(ВременныйКаталог, "server");
	КаталогЖурнала = ОбъединитьПути(ВременныйКаталог, "Журнал регистрации");
	ПутьКФайлуЖурнала = ОбъединитьПути(КаталогЖурнала, "1Cv8.lgf");
	УправлениеИБ = Новый УправлениеИБ;
	УправлениеИБ.УстановитьПараметрыФайловойИБ(КаталогИБ);
	УправлениеИБ.УстановитьПараметрыАвтономногоСервера(ОбъединитьПути(ВременныйКаталог, "init"));
	УправлениеИБ.СоздатьИБ();

	ФС.ОбеспечитьКаталог(КаталогДанных);
	КонфигурационныйФайл = Новый КонфигурационныйФайлАС;
	// Для проверки файла ЖР доступ к серверу по сети не нужен, отдельный подбор порта не требуется.
	КонфигурационныйФайл.ПараметрыСервера("127.0.0.1", 0);
	КонфигурационныйФайл.ПараметрыИБ("TestEventLog", Истина, Истина);
	КонфигурационныйФайл.ПараметрыФункциональностиСервера(Ложь);
	ПутьКонфигурации = ОбъединитьПути(КаталогДанных, "ibsrv.yaml");
	КонфигурационныйФайл.СоздатьКонфигурационныйФайл(ПутьКонфигурации);

	АвтономныйСервер = Новый УправлениеАС;
	АвтономныйСервер.УстановитьВерсиюПлатформы(УправлениеИБ.Версия());
	АвтономныйСервер.УстановитьКаталогДанных(КаталогДанных);
	АвтономныйСервер.УстановитьПараметрыФайловойИБ(КаталогИБ);
	АвтономныйСервер.УстановитьКонфигурационныйФайл(ПутьКонфигурации);
	ТекКаталог = ТекущийКаталог();
	УстановитьТекущийКаталог(ВременныйКаталог);
	Попытка
		АвтономныйСервер.УстановитьКаталогЖурналаРегистрации("Журнал регистрации");
	Исключение
		УстановитьТекущийКаталог(ТекКаталог);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьТекущийКаталог(ТекКаталог);

	// Когда
	АвтономныйСервер.Запустить();
	Для ПопыткаОжидания = 1 По 20 Цикл
		Если ФС.ФайлСуществует(ПутьКФайлуЖурнала) Тогда
			Прервать;
		КонецЕсли;
		Приостановить(500);
	КонецЦикла;
	АвтономныйСервер.Остановить();

	// Тогда
	Утверждения.ПроверитьИстину(ФС.ФайлСуществует(ПутьКФайлуЖурнала),
		"ibsrv должен создать файл журнала регистрации в указанном каталоге");

КонецПроцедуры

Процедура ПослеЗапускаТеста() Экспорт

	Если АвтономныйСервер <> Неопределено Тогда
		АвтономныйСервер.Остановить();
		АвтономныйСервер = Неопределено;
	КонецЕсли;

	Если ЗначениеЗаполнено(ВременныйКаталог) Тогда
		ВременныеФайлы.УдалитьФайл(ВременныйКаталог);
		ВременныйКаталог = "";
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

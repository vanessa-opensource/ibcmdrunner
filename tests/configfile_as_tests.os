// BSLLS:LatinAndCyrillicSymbolInWord-off

// Тесты генератора конфигурационного файла автономного сервера
// (класс КонфигурационныйФайлАС).
// Созданный YAML-файл разбирается обратно библиотекой oscript-yaml,
// проверяется структура и значения секций. Установленная платформа 1С не требуется.

#Использовать ".."
#Использовать asserts
#Использовать oscript-yaml

Перем ПоследнийТекстКонфигурации; // Строка - текст последнего созданного конфигурационного файла

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ЗаписатьСекциюСервераИФайловойБазы() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыСервера("127.0.0.1", 8314, "MyServer");
	КонфигФайл.ПараметрыФайловойБД("d:\bases\mybase");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Сервер = Данные.Получить("server");
	Утверждения.ПроверитьРавенство(8314, Сервер.Получить("port"), "Порт должен быть числом 8314");
	Утверждения.ПроверитьРавенство("127.0.0.1", Сервер.Получить("address"));
	Утверждения.ПроверитьРавенство("MyServer", Сервер.Получить("host"));

	// Путь с обратными слэшами проверяется по тексту файла:
	// в oscript-yaml 0.3.0 десериализатор некорректно разбирает "\\b"
	// (эскейп "\b" обрабатывается раньше "\\"), хотя сериализация корректна.
	ТекстФайла = ПоследнийТекстКонфигурации;
	Утверждения.ПроверитьИстину(СтрНайти(ТекстФайла, "path: ""d:\\bases\\mybase""") > 0,
		"Путь к файловой базе должен быть корректно экранирован в YAML: " + ТекстФайла);

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗаписыватьХостЕслиНеЗадан() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыСервера("localhost", 8314);

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Сервер = Данные.Получить("server");
	Утверждения.ПроверитьРавенство(Неопределено, Сервер.Получить("host"),
		"Незаданное имя хоста не должно попадать в файл");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьСекциюСервернойБазыДанных() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыСервернойБД("PostgreSQL", "db-host", "base1", "dbuser", "dbpwd");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	БазаДанных = Данные.Получить("database");
	Утверждения.ПроверитьРавенство("PostgreSQL", БазаДанных.Получить("dbms"));
	Утверждения.ПроверитьРавенство("db-host", БазаДанных.Получить("server"));
	Утверждения.ПроверитьРавенство("base1", БазаДанных.Получить("name"));
	Утверждения.ПроверитьРавенство("dbuser", БазаДанных.Получить("user"));
	Утверждения.ПроверитьРавенство("dbpwd", БазаДанных.Получить("password"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьСекциюИнформационнойБазы() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыИБ("test", Истина, Ложь, "b4faf1f6-8f9c-40a9-b42d-6a08eb6c99ab");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	ИБ = Данные.Получить("infobase");
	Утверждения.ПроверитьРавенство("b4faf1f6-8f9c-40a9-b42d-6a08eb6c99ab", ИБ.Получить("id"));
	Утверждения.ПроверитьРавенство("test", ИБ.Получить("name"));
	Утверждения.ПроверитьРавенство(Истина, ИБ.Получить("distribute-licenses"),
		"Разрешение выдачи лицензий должно быть булевым true");
	Утверждения.ПроверитьРавенство(Ложь, ИБ.Получить("shedule-jobs"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьРазделителиСРазнымиЗначениями() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ДобавитьПараметрыВеб_Разделители("zone1", Истина, Ложь, Истина);
	КонфигФайл.ДобавитьПараметрыВеб_Разделители("zone2", Ложь, Истина, Ложь);

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Хттп = Данные.Получить("http");
	Утверждения.ПроверитьРавенство("/", Хттп.Получить("base"));

	Зоны = Хттп.Получить("zones");
	Утверждения.ПроверитьТип(Зоны, "Массив", "Разделители должны быть массивом");
	Утверждения.ПроверитьРавенство(2, Зоны.Количество());

	Утверждения.ПроверитьРавенство("zone1", Зоны[0].Получить("value"),
		"Первый разделитель должен сохранить свое значение");
	Утверждения.ПроверитьРавенство(Истина, Зоны[0].Получить("safe"));
	Утверждения.ПроверитьРавенство(Ложь, Зоны[0].Получить("specify"));

	Утверждения.ПроверитьРавенство("zone2", Зоны[1].Получить("value"),
		"Второй разделитель должен сохранить свое значение");
	Утверждения.ПроверитьРавенство(Ложь, Зоны[1].Получить("safe"));
	Утверждения.ПроверитьРавенство(Истина, Зоны[1].Получить("specify"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьСекциюПриложения() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВеб_Приложение("http://exit.url", Истина);

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Приложение = Данные.Получить("http").Получить("application");
	Утверждения.ПроверитьТип(Приложение, "Соответствие", "Секция application должна присутствовать");
	Утверждения.ПроверитьРавенство(Истина, Приложение.Получить("publish"));
	Утверждения.ПроверитьРавенство("http://exit.url", Приложение.Получить("exit-url"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьАутентификациюБезСтандартной() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВеб_Аутентификация("http://openid.local", 86400, , , Ложь);

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Аутентификация = Данные.Получить("http").Получить("auth");
	Утверждения.ПроверитьРавенство("http://openid.local", Аутентификация.Получить("rely").Получить("url"));
	Утверждения.ПроверитьРавенство(86400, Аутентификация.Получить("rely").Получить("lifetime"));
	Утверждения.ПроверитьРавенство(Ложь, Аутентификация.Получить("provider").Получить("allow-standard"),
		"При запрете стандартной аутентификации должен быть записан allow-standard: false");

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеЗаписыватьРазрешеннуюСтандартнуюАутентификацию() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВеб_Аутентификация("http://openid.local");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Аутентификация = Данные.Получить("http").Получить("auth");
	Утверждения.ПроверитьРавенство(Неопределено, Аутентификация.Получить("provider"),
		"При разрешенной стандартной аутентификации подсекция provider не записывается");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьПубликациюODataСПовторнымИспользованием() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	ПараметрыСеансов = Новый Соответствие;
	ПараметрыСеансов.Вставить("mode", "AutoUse");
	ПараметрыСеансов.Вставить("pool-size", 10);
	КонфигФайл.ПараметрыВеб_ПубликацияOData(Истина, ПараметрыСеансов);

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	OData = Данные.Получить("http").Получить("odata");
	Утверждения.ПроверитьРавенство(Истина, OData.Получить("publish"));
	СеансыИзФайла = OData.Получить("reuse-sessions");
	Утверждения.ПроверитьТип(СеансыИзФайла, "Соответствие",
		"Параметры повторного использования сеансов должны попадать в файл");
	Утверждения.ПроверитьРавенство("AutoUse", СеансыИзФайла.Получить("mode"));
	Утверждения.ПроверитьРавенство(10, СеансыИзФайла.Получить("pool-size"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьВебИХттпСервисы() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВебСервисовОбщие(Истина, Ложь);
	КонфигФайл.ДобавитьПараметрыВебСервиса(Истина, "ws1", "ws1alias", Неопределено, Истина);
	КонфигФайл.ПараметрыХТТПСервисовОбщие(Истина, Истина);
	КонфигФайл.ДобавитьПараметрыХТТПСервиса(Истина, "hs1", "/hs1", , Истина);

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	ВебСервисы = Данные.Получить("http").Получить("web-services");
	Утверждения.ПроверитьРавенство(Истина, ВебСервисы.Получить("publish-by-default"));
	Утверждения.ПроверитьРавенство(Ложь, ВебСервисы.Получить("publish-extensions-by-default"));
	СписокВебСервисов = ВебСервисы.Получить("service");
	Утверждения.ПроверитьРавенство(1, СписокВебСервисов.Количество());
	Утверждения.ПроверитьРавенство("ws1", СписокВебСервисов[0].Получить("name"));
	Утверждения.ПроверитьРавенство("ws1alias", СписокВебСервисов[0].Получить("alias"));

	ХттпСервисы = Данные.Получить("http").Получить("http-services");
	Утверждения.ПроверитьРавенство(Истина, ХттпСервисы.Получить("publish-extensions-by-default"));
	СписокХттпСервисов = ХттпСервисы.Получить("service");
	Утверждения.ПроверитьРавенство(1, СписокХттпСервисов.Количество(),
		"http-сервис должен попасть в подсекцию http-services, а не web-services");
	Утверждения.ПроверитьРавенство("hs1", СписокХттпСервисов[0].Получить("name"));
	Утверждения.ПроверитьРавенство("/hs1", СписокХттпСервисов[0].Получить("root"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьШлюзыФункциональностьИОтладку() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыШлюзаПрямогоДоступа(1541, 1560, 1591, 0);
	КонфигФайл.ПараметрыШлюзаSSH("localhost", "auto", 8282);
	КонфигФайл.ПараметрыФункциональностиСервера(Истина, Ложь);
	КонфигФайл.ПараметрыОтладкиСервера("tcp", 1550, "localhost");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	ПрямойШлюз = Данные.Получить("gates").Получить("direct");
	Утверждения.ПроверитьРавенство(1541, ПрямойШлюз.Получить("regport"), "Порт шлюза должен быть числом");
	Утверждения.ПроверитьРавенство("1560:1591", ПрямойШлюз.Получить("range"));
	Утверждения.ПроверитьРавенство(0, ПрямойШлюз.Получить("seclevel"));

	ШлюзSSH = Данные.Получить("gates").Получить("ssh");
	Утверждения.ПроверитьРавенство("localhost", ШлюзSSH.Получить("address"));
	Утверждения.ПроверитьРавенство("auto", ШлюзSSH.Получить("host-key"));
	Утверждения.ПроверитьРавенство(8282, ШлюзSSH.Получить("port"));

	Функциональность = Данные.Получить("features");
	Утверждения.ПроверитьРавенство(Истина, Функциональность.Получить("direct-gate"));
	Утверждения.ПроверитьРавенство(Ложь, Функциональность.Получить("http-gate"));
	Утверждения.ПроверитьРавенство(Неопределено, Функциональность.Получить("ssh-gate"),
		"Незаданная функциональность не должна попадать в файл");

	Отладка = Данные.Получить("debug");
	Утверждения.ПроверитьРавенство("tcp", Отладка.Получить("type"));
	Утверждения.ПроверитьРавенство(1550, Отладка.Получить("port"));
	Утверждения.ПроверитьРавенство("localhost", Отладка.Получить("address"));
	Утверждения.ПроверитьРавенство(Неопределено, Отладка.Получить("password"),
		"Пустой пароль отладки не должен попадать в файл");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьВнешнийСерверОтладки() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыВнешнегоСервераОтладки("http://debug-server:1550");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Отладка = Данные.Получить("debug");
	Утверждения.ПроверитьРавенство("server", Отладка.Получить("type"));
	Утверждения.ПроверитьРавенство("http://debug-server:1550", Отладка.Получить("server").Получить("url"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьПубликациюДистрибутивов() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыПубликацииДистрибутивов("w32.zip", "w64.zip", "m64.zip");

	Данные = СоздатьИРазобратьКонфиг(КонфигФайл);

	Дистрибутивы = Данные.Получить("http").Получить("pubdst");
	Утверждения.ПроверитьРавенство("w32.zip", Дистрибутивы.Получить("win32"));
	Утверждения.ПроверитьРавенство("w64.zip", Дистрибутивы.Получить("win64"));
	Утверждения.ПроверитьРавенство("m64.zip", Дистрибутивы.Получить("mac64"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПустойФайлБезПараметров() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;

	ИмяФайла = ИмяВременногоФайлаКонфигурации();
	КонфигФайл.СоздатьКонфигурационныйФайл(ИмяФайла);

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	УдалитьФайлы(ИмяФайла);

	Утверждения.ПроверитьИстину(Текст = Неопределено ИЛИ ПустаяСтрока(Текст),
		"Без установленных параметров должен быть создан пустой файл");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИРазобратьКонфиг(КонфигФайл)

	ИмяФайла = ИмяВременногоФайлаКонфигурации();

	КонфигФайл.СоздатьКонфигурационныйФайл(ИмяФайла);

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	ПоследнийТекстКонфигурации = Чтение.Прочитать();
	Чтение.Закрыть();

	Парсер = Новый ПарсерYaml;
	Данные = Парсер.ПрочитатьИзФайла(ИмяФайла);

	УдалитьФайлы(ИмяФайла);

	Утверждения.ПроверитьТип(Данные, "Соответствие", "Файл должен содержать корректный YAML-документ");

	Возврат Данные;

КонецФункции

Функция ИмяВременногоФайлаКонфигурации()
	Возврат ОбъединитьПути(КаталогВременныхФайлов(), "configfile_as_test.yml");
КонецФункции

#КонецОбласти

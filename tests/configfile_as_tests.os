// BSLLS:LatinAndCyrillicSymbolInWord-off

// Характеризационные тесты генератора конфигурационного файла
// автономного сервера (класс КонфигурационныйФайлАС).
// Фиксируют формат создаваемого YAML-файла и не требуют установленной платформы 1С.

#Использовать ".."
#Использовать asserts

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ЗаписатьСекциюСервераИФайловойБазы() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыСервера("127.0.0.1", 8314, "MyServer");
	КонфигФайл.ПараметрыФайловойБД("d:\bases\mybase");

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "server:
	|  port: 8314
	|  address: 127.0.0.1
	|  host: MyServer
	|database:
	|  path: d:\bases\mybase
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Конфигурационный файл должен содержать секции server и database");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьСекциюСервернойБазыДанных() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыСервернойБД("PostgreSQL", "db-host", "base1", "dbuser", "dbpwd");

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "database:
	|  dbms: PostgreSQL
	|  server: db-host
	|  name: base1
	|  user: dbuser
	|  password: dbpwd
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Конфигурационный файл должен содержать параметры серверной базы данных");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьСекциюИнформационнойБазы() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыИБ("test", Истина, Ложь, "b4faf1f6-8f9c-40a9-b42d-6a08eb6c99ab");

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "infobase:
	|  id: b4faf1f6-8f9c-40a9-b42d-6a08eb6c99ab
	|  name: test
	|  distribute-licenses: true
	|  shedule-jobs: false
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Конфигурационный файл должен содержать секцию infobase");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьРазделителиСРазнымиЗначениями() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ДобавитьПараметрыВеб_Разделители("zone1", Истина, Ложь, Истина);
	КонфигФайл.ДобавитьПараметрыВеб_Разделители("zone2", Ложь, Истина, Ложь);

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "http:
	|  base: /
	|  zones:
	|   -
	|      value: zone1
	|      safe: true
	|      specify: false
	|   -
	|      value: zone2
	|      safe: false
	|      specify: true
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Каждый разделитель должен быть записан со своими значениями");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьСекциюПриложения() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВеб_Приложение("http://exit.url", Истина);

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "http:
	|  base: /
	|  application:
	|    publish: true
	|    exit-url: http://exit.url
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Конфигурационный файл должен содержать подсекцию application");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьАутентификациюБезСтандартной() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВеб_Аутентификация("http://openid.local", 86400, , , Ложь);

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "http:
	|  base: /
	|  auth:
	|    rely:
	|      url: http://openid.local
	|      lifetime: 86400
	|    provider:
	|      allow-standard: false
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"При запрете стандартной аутентификации должна быть записана строка allow-standard: false");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьПубликациюODataСПовторнымИспользованием() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	ПараметрыСеансов = Новый Соответствие;
	ПараметрыСеансов.Вставить("mode", "AutoUse");
	ПараметрыСеансов.Вставить("pool-size", 10);
	КонфигФайл.ПараметрыВеб_ПубликацияOData(Истина, ПараметрыСеансов);

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "http:
	|  base: /
	|  odata:
	|    publish: true
	|    reuse-sessions:
	|      mode: AutoUse
	|      pool-size: 10
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Параметры повторного использования сеансов OData должны попадать в файл");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьВебИХттпСервисы() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыВебСервисовОбщие(Истина, Ложь);
	КонфигФайл.ДобавитьПараметрыВебСервиса(Истина, "ws1", "ws1alias", Неопределено, Истина);
	КонфигФайл.ПараметрыХТТПСервисовОбщие(Истина, Истина);
	КонфигФайл.ДобавитьПараметрыХТТПСервиса(Истина, "hs1", "/hs1", , Истина);

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "http:
	|  base: /
	|  web-services:
	|    publish-by-default: true
	|    publish-extensions-by-default: false
	|    service:
	|    -
	|      publish: true
	|      name: ws1
	|      alias: ws1alias
	|  http-services:
	|    publish-by-default: true
	|    publish-extensions-by-default: true
	|    service:
	|    -
	|      publish: true
	|      name: hs1
	|      root: /hs1
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Веб-сервисы и http-сервисы должны быть записаны в свои подсекции");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьШлюзыФункциональностьИОтладку() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыШлюзаПрямогоДоступа(1541, 1560, 1591, 0);
	КонфигФайл.ПараметрыШлюзаSSH("localhost", "auto", 8282);
	КонфигФайл.ПараметрыФункциональностиСервера(Истина, Ложь);
	КонфигФайл.ПараметрыОтладкиСервера("tcp", 1550, "localhost");

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "gates:
	|  direct:
	|    regport: 1541
	|    range: 1560:1591
	|    seclevel: 0
	|  ssh:
	|    address: localhost
	|    host-key: auto
	|    port: 8282
	|features:
	|  direct-gate: true
	|  http-gate: false
	|debug:
	|  type: tcp
	|  port: 1550
	|  address: localhost
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Секции gates, features и debug должны быть записаны");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьВнешнийСерверОтладки() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыВнешнегоСервераОтладки("http://debug-server:1550");

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "debug:
	|  type: server
	|  server:
	|    url: http://debug-server:1550
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Секция debug должна содержать адрес внешнего сервера отладки");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ЗаписатьПубликациюДистрибутивов() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;
	КонфигФайл.ПараметрыХТТП("/");
	КонфигФайл.ПараметрыПубликацииДистрибутивов("w32.zip", "w64.zip", "m64.zip");

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Ожидаемое = "http:
	|  base: /
	|  pubdst:
	|    win32: w32.zip
	|    win64: w64.zip
	|    mac64: m64.zip
	|";

	Утверждения.ПроверитьРавенство(Ожидаемое, Содержимое,
		"Секция pubdst должна быть записана");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СоздатьПустойФайлБезПараметров() Экспорт

	КонфигФайл = Новый КонфигурационныйФайлАС;

	Содержимое = СоздатьИПрочитатьКонфиг(КонфигФайл);

	Утверждения.ПроверитьРавенство("", Содержимое,
		"Без установленных параметров должен быть создан пустой файл");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СоздатьИПрочитатьКонфиг(КонфигФайл)

	ИмяФайла = ОбъединитьПути(КаталогВременныхФайлов(), "configfile_as_test.yml");

	КонфигФайл.СоздатьКонфигурационныйФайл(ИмяФайла);

	Чтение = Новый ЧтениеТекста(ИмяФайла, КодировкаТекста.UTF8);
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();

	УдалитьФайлы(ИмяФайла);

	Если Текст = Неопределено Тогда
		Текст = "";
	КонецЕсли;

	Возврат СтрЗаменить(Текст, Символы.ВК, "");

КонецФункции

#КонецОбласти

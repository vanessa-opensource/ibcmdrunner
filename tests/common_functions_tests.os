// BSLLS:LatinAndCyrillicSymbolInWord-off

// Модульные тесты общего служебного модуля СлужебныйIbcmdRunner.
// Не требуют установленной платформы 1С.

#Использовать ".."
#Использовать asserts

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_СравнитьРавныеВерсии() Экспорт

	Утверждения.ПроверитьРавенство(0, СлужебныйIbcmdRunner.СравнитьВерсии("8.3.20", "8.3.20"));
	Утверждения.ПроверитьРавенство(0, СлужебныйIbcmdRunner.СравнитьВерсии("8.3", "8.3.0.0"));
	Утверждения.ПроверитьРавенство(0, СлужебныйIbcmdRunner.СравнитьВерсии("1  002", "1002"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравнитьБольшуюВерсиюСМеньшей() Экспорт

	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.СравнитьВерсии("8.3.21", "8.3.20") > 0,
		"8.3.21 должна быть больше 8.3.20");
	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.СравнитьВерсии("8.3.20.1563", "8.3.20") > 0,
		"8.3.20.1563 должна быть больше 8.3.20");
	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.СравнитьВерсии("9", "8.3.22.1704") > 0,
		"9 должна быть больше 8.3.22.1704");

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравнитьМеньшуюВерсиюСБольшей() Экспорт

	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.СравнитьВерсии("8.3.19", "8.3.20") < 0,
		"8.3.19 должна быть меньше 8.3.20");
	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.СравнитьВерсии("8.3.20", "8.3.20.100") < 0,
		"8.3.20 должна быть меньше 8.3.20.100");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазложитьВерсиюНаКомпоненты() Экспорт

	Компоненты = СлужебныйIbcmdRunner.МассивКомпонентВерсии("8.3.22.1704");

	Утверждения.ПроверитьРавенство(4, Компоненты.Количество());
	Утверждения.ПроверитьРавенство(8, Компоненты[0]);
	Утверждения.ПроверитьРавенство(3, Компоненты[1]);
	Утверждения.ПроверитьРавенство(22, Компоненты[2]);
	Утверждения.ПроверитьРавенство(1704, Компоненты[3]);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбернутьСтрокуВКавычки() Экспорт

	Утверждения.ПроверитьРавенство("""путь к файлу""", СлужебныйIbcmdRunner.ОбернутьВКавычки("путь к файлу"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_НеОборачиватьВКавычкиПовторно() Экспорт

	Утверждения.ПроверитьРавенство("""путь""", СлужебныйIbcmdRunner.ОбернутьВКавычки("""путь"""));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ОбернутьПустуюСтрокуВКавычки() Экспорт

	Утверждения.ПроверитьРавенство("""""", СлужебныйIbcmdRunner.ОбернутьВКавычки(""));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьБулевоВYesNo() Экспорт

	Утверждения.ПроверитьРавенство("yes", СлужебныйIbcmdRunner.БулевоВСтрокуYesNo(Истина));
	Утверждения.ПроверитьРавенство("no", СлужебныйIbcmdRunner.БулевоВСтрокуYesNo(Ложь));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПреобразоватьYesNoВБулево() Экспорт

	Утверждения.ПроверитьРавенство(Истина, СлужебныйIbcmdRunner.СтрокаYesNoВБулево("yes"));
	Утверждения.ПроверитьРавенство(Ложь, СлужебныйIbcmdRunner.СтрокаYesNoВБулево("no"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключениеДляНекорректногоYesNo() Экспорт

	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("maybe");

	Ожидаем.Что(СлужебныйIbcmdRunner)
		.Метод("СтрокаYesNoВБулево", ПараметрыМетода)
		.ВыбрасываетИсключение("должно быть только 'yes' или 'no'");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьКорректныеИмена() Экспорт

	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.ЯвляетсяИменем("СуперРасширение"),
		"Имя 'СуперРасширение' должно быть корректным");
	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.ЯвляетсяИменем("_служебное1"),
		"Имя '_служебное1' должно быть корректным");
	Утверждения.ПроверитьИстину(СлужебныйIbcmdRunner.ЯвляетсяИменем("extension_2"),
		"Имя 'extension_2' должно быть корректным");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПроверитьНекорректныеИмена() Экспорт

	Утверждения.ПроверитьЛожь(СлужебныйIbcmdRunner.ЯвляетсяИменем(""),
		"Пустая строка не должна быть корректным именем");
	Утверждения.ПроверитьЛожь(СлужебныйIbcmdRunner.ЯвляетсяИменем("1Расширение"),
		"Имя, начинающееся с цифры, не должно быть корректным");
	Утверждения.ПроверитьЛожь(СлужебныйIbcmdRunner.ЯвляетсяИменем("Имя Расширения"),
		"Имя с пробелом не должно быть корректным");
	Утверждения.ПроверитьЛожь(СлужебныйIbcmdRunner.ЯвляетсяИменем("Имя-Расширения"),
		"Имя с дефисом не должно быть корректным");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ПостроитьШаблонПеременнойСреды() Экспорт

	Утверждения.ПроверитьРавенство("%IBCMD_IB_PSW%",
		СлужебныйIbcmdRunner.ШаблонПеременнойСреды("IBCMD_IB_PSW", Истина));
	Утверждения.ПроверитьРавенство("$IBCMD_IB_PSW",
		СлужебныйIbcmdRunner.ШаблонПеременнойСреды("IBCMD_IB_PSW", Ложь));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьИмяЛога() Экспорт

	Утверждения.ПроверитьРавенство("oscript.lib.ibcmdrunner", СлужебныйIbcmdRunner.ИмяЛога());

КонецПроцедуры

#КонецОбласти

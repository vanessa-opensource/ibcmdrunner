// BSLLS:LatinAndCyrillicSymbolInWord-off

// Модульные тесты класса УправлениеИБ, не требующие создания информационных баз.
// Для создания объекта требуется установленная платформа 1С (утилита ibcmd).

#Использовать ".."
#Использовать asserts

#Область СлужебныйПрограммныйИнтерфейс

&Тест
Процедура ТестДолжен_ВернутьНомерВерсииПлатформы() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда
	НомерВерсии = УправлениеИБ.Версия();

	// Тогда
	РегулярноеВыражение = Новый РегулярноеВыражение("^(\d+)\.(\d+)\.(\d+)\.(\d+)\z");
	Утверждения.ПроверитьИстину(РегулярноеВыражение.Совпадает(НомерВерсии),
		"Номер версии должен соответствовать шаблону: " + НомерВерсии);

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПутьКПриложению() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда
	Путь = УправлениеИБ.ПутьКПриложению();

	// Тогда
	Утверждения.ПроверитьИстину(ЗначениеЗаполнено(Путь), "Путь к приложению ibcmd должен быть заполнен");
	Утверждения.ПроверитьИстину(СтрНайти(НРег(Путь), "ibcmd") > 0,
		"Путь к приложению должен содержать 'ibcmd': " + Путь);

КонецПроцедуры

&Тест
Процедура ТестДолжен_СравнитьВерсииЧерезУправлениеИБ() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Тогда
	Утверждения.ПроверитьИстину(УправлениеИБ.СравнитьВерсии("8.3.21", "8.3.20") > 0,
		"8.3.21 должна быть больше 8.3.20");
	Утверждения.ПроверитьРавенство(0, УправлениеИБ.СравнитьВерсии("8.3.20", "8.3.20"));
	Утверждения.ПроверитьИстину(УправлениеИБ.СравнитьВерсии("8.3.19", "8.3.20") < 0,
		"8.3.19 должна быть меньше 8.3.20");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьПустойСписокРасширений() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда
	Описания = УправлениеИБ.РазобратьСписокРасширений("");

	// Тогда
	Утверждения.ПроверитьТип(Описания, "Массив", "Метод должен вернуть массив");
	Утверждения.ПроверитьРавенство(0, Описания.Количество(), "Массив должен быть пустым");

КонецПроцедуры

&Тест
Процедура ТестДолжен_РазобратьСписокРасширений() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;
	ТекстСписка = ТекстВыводаСпискаРасширений();

	// Когда
	Описания = УправлениеИБ.РазобратьСписокРасширений(ТекстСписка);

	// Тогда
	Утверждения.ПроверитьРавенство(2, Описания.Количество(), "Должно быть разобрано два описания расширений");

	ПервоеОписание = Описания[0];
	Утверждения.ПроверитьТип(ПервоеОписание, "Соответствие", "Описание расширения должно быть соответствием");
	Утверждения.ПроверитьРавенство("СуперРасширение", ПервоеОписание.Получить("name"));
	Утверждения.ПроверитьРавенство(Истина, ПервоеОписание.Получить("active"),
		"Свойство active должно быть преобразовано в Булево");
	Утверждения.ПроверитьРавенство(Ложь, ПервоеОписание.Получить("used-in-distributed-infobase"));
	Утверждения.ПроверитьРавенство("add-on", ПервоеОписание.Получить("purpose"));
	Утверждения.ПроверитьРавенство("infobase", ПервоеОписание.Получить("scope"));
	Утверждения.ПроверитьРавенство("lq86kvw7xY6UpGB33UOtGzx01IQ=", ПервоеОписание.Получить("hash-sum"),
		"Хеш-сумма должна быть очищена от кавычек");

	ВтороеОписание = Описания[1];
	Утверждения.ПроверитьРавенство("ВтороеРасширение", ВтороеОписание.Получить("name"));
	Утверждения.ПроверитьРавенство(Ложь, ВтороеОписание.Получить("active"));
	Утверждения.ПроверитьРавенство("patch", ВтороеОписание.Получить("purpose"));

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключениеБезОбщихПараметровИБ() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("c:\tmp\dump.dt");

	// Тогда
	Ожидаем.Что(УправлениеИБ)
		.Метод("ВыгрузитьДанныеИБ", ПараметрыМетода)
		.ВыбрасываетИсключение("Необходимо установить общие параметры информационной базы");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключениеПриНекорректномИмениРасширения() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("1НекорректноеИмя");
	ПараметрыМетода.Добавить("ср");

	// Тогда
	Ожидаем.Что(УправлениеИБ)
		.Метод("СоздатьРасширение", ПараметрыМетода)
		.ВыбрасываетИсключение("удовлетворяющая требованиям к имени");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВызватьИсключениеПриНекорректномТипеСУБД() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда
	ПараметрыМетода = Новый Массив;
	ПараметрыМетода.Добавить("MySQL");
	ПараметрыМетода.Добавить("db-host");
	ПараметрыМетода.Добавить("base1");
	ПараметрыМетода.Добавить("user");
	ПараметрыМетода.Добавить("pwd");

	// Тогда
	Ожидаем.Что(УправлениеИБ)
		.Метод("УстановитьПараметрыСервернойИБ", ПараметрыМетода)
		.ВыбрасываетИсключение("Тип СУБД должен быть один из");

КонецПроцедуры

&Тест
Процедура ТестДолжен_ВернутьПустойВыводПоследнейКомандыПоУмолчанию() Экспорт

	// Дано
	УправлениеИБ = Новый УправлениеИБ;

	// Когда (при создании объекта уже выполнялась команда --version)
	Вывод = УправлениеИБ.ВыводПоследнейКоманды();

	// Тогда
	Утверждения.ПроверитьИстину(ЗначениеЗаполнено(Вывод),
		"Вывод последней команды должен содержать версию платформы");
	Утверждения.ПроверитьРавенство(0, УправлениеИБ.КодВозвратаПоследнейКоманды(),
		"Код возврата успешной команды должен быть равен 0");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстВыводаСпискаРасширений()

	Возврат "name                         : ""СуперРасширение""
		|version                      :
		|active                       : yes
		|purpose                      : add-on
		|safe-mode                    : yes
		|security-profile-name        :
		|unsafe-action-protection     : yes
		|used-in-distributed-infobase : no
		|scope                        : infobase
		|hash-sum                     : ""lq86kvw7xY6UpGB33UOtGzx01IQ=""
		|
		|name                         : ""ВтороеРасширение""
		|version                      : 1.0.0.1
		|active                       : no
		|purpose                      : patch
		|safe-mode                    : no
		|security-profile-name        :
		|unsafe-action-protection     : no
		|used-in-distributed-infobase : no
		|scope                        : infobase
		|hash-sum                     : ""XEOqtmInlTN/lMHIp7ylpc4Q2RU=""
		|";

КонецФункции

#КонецОбласти
